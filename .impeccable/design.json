      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:6px 14px 6px 7px;border-radius:999px;border:0;background:#FFFDF8;color:#1B1F27;font:700 .98rem Gabarito,system-ui,sans-serif;cursor:pointer}.ds-chip:hover{background:#F3EFE6}.ds-chip[aria-pressed=true]{background:#1B1F27;color:#FFFDF8}.ds-ci{width:30px;height:30px;border-radius:50%;background:#E8E1D2}.ds-chip[aria-pressed=true] .ds-ci{background:#FFC93C}"
