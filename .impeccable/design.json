      "css": ".ds-btn{display:inline-flex;align-items:center;gap:12px;min-height:56px;padding:8px 24px 8px 8px;border-radius:999px;background:#1B1F27;color:#FFFDF8;font:800 1.08rem/1.1 Gabarito,system-ui,sans-serif;text-decoration:none;box-shadow:0 1px 0 rgba(27,31,39,.1),0 12px 26px -14px rgba(27,31,39,.7);transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{transform:translateY(-2px)}.ds-btn:focus-visible{outline:3px solid #1B1F27;outline-offset:3px}.ds-bulb{width:40px;height:40px;border-radius:50%;background:#FFC93C;color:#1B1F27;display:grid;place-items:center}"
    },
